{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "api.app:app"
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)\\.(js|css|png|jpg|jpeg|webp|svg|ico|json|txt|webmanifest|xml)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        },
        {
            "source": "/((?!api).*)",
            "destination": {
                "type": "service",
                "service": "frontend",
                "path": "index.html"
            }
        }
    ]
}
